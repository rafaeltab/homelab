          "editorMode": "code",
          "expr": "sum by (gen_ai_tool_name) (increase(hermes_tool_calls_total{service_name=\"hermes-agent\",hermes_platform=~\"${platform:regex}\",gen_ai_tool_name=~\"${tool:regex}\",hermes_status=\"error\"}[$__range])) / clamp_min(sum by (gen_ai_tool_name) (increase(hermes_tool_calls_total{service_name=\"hermes-agent\",hermes_platform=~\"${platform:regex}\",gen_ai_tool_name=~\"${tool:regex}\"}[$__range])),1)",
