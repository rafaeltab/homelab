      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "round(sum(increase(hermes_gen_ai_requests_total{service_name=\"hermes-agent\",hermes_platform=~\"${platform:regex}\",hermes_status=\"error\"}[$__range]))) or vector(0)",
          "instant": true,
          "legendFormat": "errors",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Model Request Errors",
