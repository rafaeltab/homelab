      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum by (gen_ai_tool_name) (rate(hermes_tool_calls_total{service_name=\"hermes-agent\",hermes_platform=~\"${platform:regex}\",gen_ai_tool_name=~\"${tool:regex}\",hermes_status=\"error\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_tool_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Tool Errors over Time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
