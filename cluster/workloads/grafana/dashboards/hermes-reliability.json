        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hermes_gen_ai_request_duration_seconds_bucket{service_name=\"hermes-agent\",hermes_platform=~\"${platform:regex}\"}[$__rate_interval])))",
          "legendFormat": "model p95",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hermes_tool_duration_seconds_bucket{service_name=\"hermes-agent\",hermes_platform=~\"${platform:regex}\",gen_ai_tool_name=~\"${tool:regex}\",gen_ai_tool_name!=\"clarify\"}[$__rate_interval])))",
          "legendFormat": "tool p95 excluding clarify",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "p95 Latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
